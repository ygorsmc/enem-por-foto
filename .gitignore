# Ambiente e segredos
.venv/
.env

# Caches de ferramentas
__pycache__/
.pytest_cache/
.ruff_cache/
.claude/

# Deploy secrets (Azure/Upstash/Telegram/API keys) — só o .example é versionado.
deploy/.env.deploy

# Laboratório, dados e documentação-fonte: tudo em _local/ (existe só neste disco). Inclui o corpus
# Essay-BR (MIT, github.com/lplnufpi/essay-br), as fotos de redação (LGPD: foto real de aluno nunca vai
# para o git), resultados de avaliação, datasets de features e os scripts que os geram. O portal
# renderizado docs/index.html CONTINUA versionado: é o deliverable; só a fonte que o gera fica de fora.
_local/

# Rede de segurança para saída de laboratório que caia na raiz por engano: o CatBoost grava
# catboost_info/ no diretório atual, e versões antigas dos scripts gravavam CSV e fotos aqui.
/redacoes/
/catboost_info/
/*.csv

# Guia de agentes de codificação e memória entre sessões — instruções de
# desenvolvimento local, não do produto. Precisam continuar NA RAIZ (não em
# _local/) para o Claude Code carregá-los automaticamente.
AGENTS.md
CLAUDE.md
MEMORY.md

# Artefatos do fluxo híbrido (modelo treinado, perguntas do Jev, cortes do checklist).
# Gerados por _local/scripts/jev_v4_export.py — fora do repo público de propósito.
src/correction/hybrid/artifacts/

# Respostas do Jev para o corpus do notebook: não são redistribuídas; cada um coleta as suas com a própria chave
# da API (notebooks/coletar_jev.py).
notebooks/data/essaybr_jev.csv.gz
notebooks/data/jev_respostas/
