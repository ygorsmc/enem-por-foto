# Ambiente e segredos
.venv/
.env

# Caches de ferramentas
__pycache__/
.pytest_cache/
.ruff_cache/
.claude/

# Dados pessoais e saída de laboratório — nunca versionar (o produto é
# LGPD-consciente: fotos reais de redação de alunos não pertencem ao git).
redacoes/
ocr_experiments/
prompt_ab_results/

# Deploy secrets (Azure/Upstash/Telegram/API keys) — só o .example é versionado.
deploy/.env.deploy

# Corpus Essay-BR (MIT, github.com/lplnufpi/essay-br) usado para medir
# acurácia da nota estimada — dataset de terceiro, baixado sob demanda, não
# faz sentido versionar 13MB de CSV. Ver _local/scripts/essay_br_eval.py.
essay_br/
essay_br_results/
essay_br_results_gemini35fl
heldout_deepseek_seed7
gemini_prompt_ab_results
essay_br_results_v2
heldout_deepseek_seed7_high
heldout_deepseek_seed7_medium
heldout_deepseek_seed7_low

# Corridas de variância (mesma redação N vezes) e datasets de feature gerados
# a partir do corpus. Mesma razão de tudo acima: saída de laboratório derivada
# de dataset de terceiro, reproduzível por script, pesada e sem valor no git.
# A evidência de medição consolidada fica em _local/medicoes/ (já ignorado).
triplicata_deepseek_*/
dataset_*.csv

# Ferramental de laboratório/documentação-fonte e docs de referência de
# terceiros — ficam no disco para desenvolvimento local, mas não são parte
# do produto publicável. O portal renderizado docs/index.html CONTINUA
# versionado — é o deliverable; só a fonte que o gera fica de fora.
_local/

# Guia de agentes de codificação e memória entre sessões — instruções de
# desenvolvimento local, não do produto. Precisam continuar NA RAIZ (não em
# _local/) para o Claude Code carregá-los automaticamente.
AGENTS.md
CLAUDE.md
MEMORY.md

# Artefatos do fluxo híbrido (modelo treinado, perguntas do Jev, cortes do checklist).
# Gerados por _local/scripts/jev_v4_export.py — fora do repo público de propósito.
src/correction/hybrid/artifacts/
